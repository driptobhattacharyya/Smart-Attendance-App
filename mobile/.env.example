# Address of the Attendify API. Use your LAN IP (not localhost) when testing on a phone,
# or http://10.0.2.2:8000/api/v1 from the Android emulator.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Used at build time for the map on Android (restrict it to com.attendify.app in Google Cloud).
GOOGLE_MAPS_API_KEY=

# Google Cloud project NUMBER linked to the app in Play Console. Enables the Play Integrity
# token sent with check-in and heartbeats (optional: without it no token is sent).
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
