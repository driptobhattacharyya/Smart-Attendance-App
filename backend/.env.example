# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=attendify
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=720
# Production only: when set, every request except /api/health must carry the header
# X-Origin-Auth: <this value> (the Cloudflare proxy adds it). Leave unset for local dev.
# ORIGIN_SECRET=
# Comma-separated browser origins allowed to call the API (the admin panel)
CORS_ORIGINS=http://localhost:5173
ALLOW_SELF_REGISTRATION=true

# opencv (default, open source) or azure (needs `uv sync --extra azure` and Microsoft
# Limited Access approval for Face identification/verification)
FACE_PROVIDER=opencv
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
AZURE_PERSON_GROUP_ID=attendify
FACE_MODELS_DIR=models
FACE_MATCH_THRESHOLD=0.363
FACE_VERIFICATION_TTL_MINUTES=10

# Beacon (iBeacon) presence: time only counts while the desk beacon is heard
REQUIRE_BLUETOOTH=true
BLUETOOTH_MIN_RSSI=-80
HEARTBEAT_INTERVAL_SECONDS=300
HEARTBEAT_GRACE_MINUTES=15
MAX_SESSION_HOURS=14
