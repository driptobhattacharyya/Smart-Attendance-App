# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Request handlers connect as attendify_app (row level security applies). The BYPASSRLS
# attendify_system role is used only by signup, pre-login auth lookups and desk device auth.
# Through a transaction pooler (Supabase/Neon/RDS Proxy) use the pooler host and port.
DATABASE_URL=postgresql://attendify_app:attendify_app@localhost:5432/attendify
DATABASE_SYSTEM_URL=postgresql://attendify_system:attendify_system@localhost:5432/attendify
# Table owner; Alembic only (falls back to DATABASE_URL, which cannot create tables)
DATABASE_OWNER_URL=postgresql://postgres:postgres@localhost:5432/attendify
# Optional: set the two role passwords while running `alembic upgrade head`
# ATTENDIFY_APP_PASSWORD=
# ATTENDIFY_SYSTEM_PASSWORD=
# Serverless runtimes: skip the client-side pool
DB_NULL_POOL=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
# base64 of 32 random bytes: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Shared secret for /api/v1/internal/* jobs (EventBridge)
INTERNAL_JOB_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# console prints e-mails to the log; capture is for tests
EMAIL_BACKEND=console
# Base URL of the admin web app, used in reset/invite links
PUBLIC_APP_URL=http://localhost:5173

# Production only: when set, every request except /api/v1/health must carry the header
# X-Origin-Auth: <this value> (the Cloudflare proxy adds it). Leave unset for local dev.
# ORIGIN_SECRET=
# Comma-separated browser origins allowed to call the API (the admin panel)
CORS_ORIGINS=http://localhost:5173
ALLOW_SIGNUP=true
DEFAULT_MAX_EMPLOYEES=50

# Rate limits (Postgres backed)
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15

# Attendify Desk (docs/architecture-v5.md section 6)
DESK_PAIRING_TTL_MINUTES=15
DESK_HEARTBEAT_INTERVAL_SECONDS=60

# Wording of the consent text; the face package has its own settings
FACE_PROVIDER=opencv
PRESENCE_RETENTION_DAYS=90
